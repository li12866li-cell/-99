# DEEPSEEK_API_KEY: Required for real DeepSeek AI Vet calls (Server-side only, never exposed to browser).
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# GEMINI_API_KEY: Optional fallback / multimodal image analysis key (Food Scan & Wardrobe Vision).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# KAKAO_MAP_API_KEY: Required for Kakao Local REST API (Address -> Lat/Lng).
KAKAO_MAP_API_KEY="MY_KAKAO_REST_API_KEY"

# VITE_PYTHON_API_URL: Optional URL when connecting frontend Axios client to standalone Python FastAPI backend (e.g. http://localhost:8000).
# Leave unset in AI Studio to route /api/* through the built-in Express server.
VITE_PYTHON_API_URL=""

# JWT_SECRET_KEY: Server-side secret used to sign & verify user session JWT tokens.
# Keep secret; in dev environments if unset, an ephemeral server secret is generated at startup.
JWT_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET"
JWT_EXPIRE_MINUTES="10080"

# SMTP_* (Optional): Configure real SMTP credentials to send password reset emails.
# If left unset, the app explicitly discloses dev-mode status instead of faking email delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="PetCare AI <noreply@petcare.local>"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
